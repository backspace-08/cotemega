# ──────────────────────────────────────────────
# Режим работы: production | local
#   production — вебхук (BOT_TOKEN + WEBHOOK_URL)
#   local      — polling (LOCAL_BOT_TOKEN, WEBHOOK_URL игнорируется)
# ──────────────────────────────────────────────
MODE=production

# ── Бот ──
BOT_TOKEN=your_bot_token_here
WEBHOOK_URL=https://yourdomain.com/webhook
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=9080
# Отдельный тестовый бот для MODE=local (не трогает прод-вебхук)
LOCAL_BOT_TOKEN=your_local_bot_token_here

ADMIN_ID=your_telegram_id

# ── База данных (Postgres) ──
DB_NAME=game_bot
DB_USER=cote_megaverse_backspace
DB_PASSWORD=your_password
DB_HOST=localhost          # в docker-compose подставляется postgres
DB_PORT=5432
# Полный DSN, опционально перекрывает DB_*:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Redis (состояние матчей арены) ──
REDIS_URL=redis://localhost:6379/0   # в docker-compose — redis://redis:6379/0

# ── Арена ──
ARENA_SEASON_WEEKS=3
START_SPINS=10
ARENA_TURN_TIMEOUT=60
ARENA_WARN_BEFORE=15
ARENA_COMMENTS_PER_TURN=2

# ── Магазин ──
SHOP_MIN_CARDS=30          # доступ: не меньше N карточек
SHOP_SLOTS=3               # лотов в день
SHOP_DISCOUNT=0.30         # скидка на прокачку (кроме спешлов)
SHOP_SPECIAL_COST=400      # спешл: фикс. цена за уровень
SHOP_RESET_HOUR_UTC=0      # час сброса ротации (UTC)

# ── Фразы подтверждения опасных админ-команд ──
FULL_RESET_PHRASE=ПОЛНАЯ_ОТЧИСТКА
CLEAR_PVP_PHRASE=ОЧИСТИТЬ_ПВП
CLEAR_PVE_PHRASE=ОЧИСТИТЬ_ПВЕ
RESET_BOT_PHRASE=СБРОС_БОТА
RESET_ARENA_PHRASE=СБРОС_АРЕНЫ
SEASON_END_PHRASE=КОНЕЦ_СЕЗОНА

# ── PvE / CFR ──
CFR_ENABLED=1
CFR_DEPTH=3
CFR_ITERS=120
CFR_CAP=6
# Одновременных решений солвера (ограничивает пики CPU). 1 = максимум одно ядро.
CFR_MAX_CONCURRENCY=1
# Максимум одновременных PvE-матчей (0 = без лимита).
CFR_MAX_ACTIVE=0
# Путь к приватной 1v1-таблице (не в гите; копируется вручную/на сервере).
# CFR_TABLE_PATH=/app/cote_cfr/1v1_table.csv

# ── Донат (Lava) ──
LAVA_API_KEY=your_lava_api_key
LAVA_WEBHOOK_SECRET=your_lava_webhook_secret
LAVA_WH_URL=https://yourdomain.com/lava_webhook
LAVA_OFFER_ID=your_offer_uuid

# ──────────────────────────────────────────────
# Cloudflare R2 (карточки, статы, каталог)
# ──────────────────────────────────────────────
# Публичное чтение (рантайм)
R2_PUBLIC_BASE_URL=https://megaverse-cards.dcote.net
CHARACTERS_URL=https://megaverse-cards.dcote.net/data/cote/characters.json
# База для картинок; по умолчанию — папка characters.json (…/data/cote).
# CARD_IMAGES_BASE_URL=https://megaverse-cards.dcote.net/data/cote

# Запись
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=megaverse
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PREFIX=data/cote
